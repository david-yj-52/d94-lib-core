<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tsh.d94</groupId>
        <artifactId>d94-lib-pom</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>tsh.d94</groupId>
    <artifactId>d94-lib-core</artifactId>
    <name>d94-lib-core</name>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- kotlin-maven-plugin 제거 후 maven-compiler-plugin으로 교체 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        d94-lib-core는 별도 GitHub 저장소라 로컬 relativePath(../d94-lib-pom/pom.xml)로 parent를 찾지 못하는 경우가 있습니다.
        CI(및 로컬 최초 빌드)에서 GitHub Packages에 배포된 d94 parent pom을 내려받도록 등록합니다.
    -->
    <repositories>
        <repository>
            <id>github-d94</id>
            <url>https://maven.pkg.github.com/david-yj-52/d94-lib-pom</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <!-- d94-lib-core 자체를 GitHub Packages에 배포합니다. -->
    <distributionManagement>
        <repository>
            <id>github-lib-core</id>
            <name>GitHub Packages - d94-lib-core</name>
            <url>https://maven.pkg.github.com/david-yj-52/d94-lib-core</url>
        </repository>
        <snapshotRepository>
            <id>github-lib-core</id>
            <name>GitHub Packages - d94-lib-core</name>
            <url>https://maven.pkg.github.com/david-yj-52/d94-lib-core</url>
        </snapshotRepository>
    </distributionManagement>

</project>
